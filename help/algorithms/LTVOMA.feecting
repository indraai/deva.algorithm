::BEGIN:MAIN
func: orient(opts) => {
	return '> {{opts[0]}} to {{opts[1]}} {{opts[1]}} to {{opts[0]}}'
}

// insertOrient appends the opts at a specified index or appends the opts to the end of the array where no index is provided.
func: insertOrient (opts, idx=false) {
	if (idx === false) return orients.append(opts); // append by default
	if (!isArray(opts)) return 'Please provide an options array.' // options array check
	return orients.insert(opts, idx); // array insert at index.
}
// removeOrient takes the idx parameter and removes the element at the specified index.
func: removeOrient(idx=false) {
	if (idx === false) return 'Please provide an index.' // idx check
	return orients.remove(idx); // remove element at index.
}

// Quinn Note > When applying decision modeling the first index [0] of the array is assigned an assumed value of +100 and the second index [1] is a rating score of -100 where as each orientation is cleared it contributes to a complete number that can be analyzed and compared to other instances of a similar or same number rating.

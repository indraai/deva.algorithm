::BEGIN:MAIN
# #LTVOMA 
p: Long Term Vector Orientation Modeling Algorithm

func: orientation(opts) => {
	return '> {{opts[0]}} to {{opts[1]}} {{opts[1]}} to {{opts[0]}}'
}

// insertOrientation appends the opts at a specified index or appends the opts to the end of the array where no index is provided.
func: insertOrientation (opts, idx=false) {
	if (!isArray(opts)) return 'Please provide an options array.' // options array check
	if (idx === false) return orientations.append(opts); // append by default
	return orientations.insert(opts, idx); // array insert at index.
}
// removeOrientation takes the idx parameter and removes the element at the specified index.
func: removeOrientation(idx=false) {
	if (idx === false) return 'Please provide an index.' // idx check
	return orientations.remove(idx); // remove element at index.
}

// Note > Each orientation is scored on a scale from +100 (index [0]) to −100 (index [1]), with 0 as the neutral midpoint. A neutral pair, or a pair that lands balanced between its two sides, contributes 0. As each orientation is cleared, its score adds to a total that can be compared with other instances that have the same or a similar rating.

